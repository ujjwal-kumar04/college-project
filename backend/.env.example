# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mcqquiz

# JWT Secret Key (Change this to a secure random string - minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_here

# Session Secret (for passport sessions - minimum 32 characters)
SESSION_SECRET=your_session_secret_key_here

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# OpenAI Configuration for AI Interview Practice
# Required for live AI question generation, answer evaluation, speech-to-text, and text-to-speech
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# Gemini Configuration for AI Interview Practice
# Use your Gemini key for question generation and answer analysis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AI text provider for question generation + answer analysis
# Values: auto | gemini | openai
# auto prefers Gemini when GEMINI_API_KEY is available
AI_TEXT_PROVIDER=auto

# Server Port
PORT=5001

# Node Environment
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=https://quizmatrix.vercel.app

# Nodemailer Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password_here
EMAIL_FROM="McqQuiz" <your_email@example.com>

# Optional sender/app name
APP_NAME=McqQuiz

# Cloudinary Configuration
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
